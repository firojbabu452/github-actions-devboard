# Build stage
FROM node:24 AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build


# Runtime stage
FROM node:24-alpine AS runner

WORKDIR /app

COPY package*.json ./

RUN npm ci --omit=dev

RUN npm install -g vite

COPY --from=builder /app/dist ./dist

EXPOSE 4173

CMD ["npm","run","preview","--","--host","0.0.0.0","--port","4173"]
